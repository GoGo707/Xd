local memoryManager = {
    instances = {},
    connections = {},
    tweens = {}
}

function memoryManager:track(instance, category)
    category = category or "general"
    if not self.instances[category] then
        self.instances[category] = {}
    end
    table.insert(self.instances[category], instance)
    return instance
end

function memoryManager:cleanup(category)
    if category then
        if self.instances[category] then
            for _, instance in ipairs(self.instances[category]) do
                pcall(function() instance:Destroy() end)
            end
            self.instances[category] = {}
        end
    else
        for category, instances in pairs(self.instances) do
            for _, instance in ipairs(instances) do
                pcall(function() instance:Destroy() end)
            end
        end
        self.instances = {}
    end
end

local function advancedTween(object, properties, duration, easingStyle, easingDirection)
    local tweenInfo = TweenInfo.new(
        duration or 0.2,
        easingStyle or Enum.EasingStyle.Quad,
        easingDirection or Enum.EasingDirection.Out
    )
    local tween = ts:Create(object, tweenInfo, properties)
    tween:Play()
    return tween
end

local function createRippleEffect(button, color)
    color = color or colorPalette.primary
    local ripple = Instance.new("Frame")
    ripple.Name = "RippleEffect"
    ripple.BackgroundColor3 = color
    ripple.BackgroundTransparency = 0.7
    ripple.Size = UDim2.new(0, 0, 0, 0)
    ripple.Position = UDim2.new(0.5, 0, 0.5, 0)
    ripple.AnchorPoint = Vector2.new(0.5, 0.5)
    ripple.ZIndex = button.ZIndex + 1
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = ripple
    ripple.Parent = button
    local tween1 = advancedTween(ripple, {
        Size = UDim2.new(2, 0, 2, 0),
        BackgroundTransparency = 1
    }, 0.6)
    tween1.Completed:Connect(function()
        ripple:Destroy()
    end)
end

local function applyAdvancedShadow(frame)
    local shadow = Instance.new("ImageLabel")
    shadow.Name = "AdvancedShadow"
    shadow.Image = "rbxassetid://5554236805"
    shadow.ScaleType = Enum.ScaleType.Slice
    shadow.SliceCenter = Rect.new(23, 23, 277, 277)
    shadow.BackgroundTransparency = 1
    shadow.Size = UDim2.new(1, 24, 1, 24)
    shadow.Position = UDim2.new(0, -12, 0, -12)
    shadow.ImageColor3 = Color3.fromRGB(0, 0, 0)
    shadow.ImageTransparency = 0.8
    shadow.ZIndex = frame.ZIndex - 1
    shadow.Parent = frame.Parent
    return shadow
end

