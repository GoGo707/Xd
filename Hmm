            local percentage = math.max(0, math.min(1, relativex / slidersize))
            local value = min_value + (percentage * (max_value - min_value))
            return value
        end

        trigger.MouseButton1Down:Connect(function()
            isdragging = true
        end)

        trigger.MouseButton1Up:Connect(function()
            isdragging = false
        end)

        local connection
        local function startdragging()
            if connection then
                connection:Disconnect()
            end

            connection = runservice.Heartbeat:Connect(function()
                if isdragging then
                    local mouse = game.Players.LocalPlayer:GetMouse()
                    local newvalue = getvaluefromposition(mouse.X)
                    updateslider(newvalue)
                end
            end)
        end

        trigger.MouseButton1Down:Connect(startdragging)

        trigger.TouchTap:Connect(function(touch, processed)
            if not processed then
                local newvalue = getvaluefromposition(touch.Position.X)
                updateslider(newvalue)
            end
        end)

        trigger.TouchPan:Connect(function(touch, totaltranslation, velocity, state, processed)
            if not processed then
                if state == Enum.UserInputState.Begin then
                    isdragging = true
                    startdragging()
                elseif state == Enum.UserInputState.End then
                    isdragging = false
                end

                if state == Enum.UserInputState.Change then
                    local newvalue = getvaluefromposition(touch.Position.X)
                    updateslider(newvalue)
                end
            end
        end)

        uis.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or
                input.UserInputType == Enum.UserInputType.Touch then
                isdragging = false
                if connection then
                    connection:Disconnect()
                end
            end
        end)

        trigger.MouseButton1Down:Connect(function()
            local mouse = game.Players.LocalPlayer:GetMouse()
            local newvalue = getvaluefromposition(mouse.X)
            updateslider(newvalue)
        end)

        updateslider(starting_value)

        actualvalue:GetPropertyChangedSignal("Value"):Connect(function()
            slidersng.callback(actualvalue.Value)
        end)
    end
    task.spawn(C_f)

    memoryManager:track(singularity["2"], "sliders")
    return slider
end

